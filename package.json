{
  "name": "@kud/ink-markdown",
  "version": "0.3.2",
  "type": "module",
  "description": "A high-performance Markdown / code / diff rendering engine for Ink.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://kud.io/projects/ink-markdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/ink-markdown.git"
  },
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ink": ">=7",
    "react": ">=19"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "cli-highlight": "2.1.11",
    "slice-ansi": "9.0.0",
    "string-width": "8.2.2",
    "wrap-ansi": "10.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "ink": "8.0.0",
    "ink-testing-library": "4.0.0",
    "react": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
